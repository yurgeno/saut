{
  "name": "saut",
  "version": "0.6.4",
  "private": true,
  "description": "SAUT (Skill Assurance Under Trust) — lint, cost and test agent skills for any harness",
  "license": "Apache-2.0",
  "author": "Yuriy Orlov (https://github.com/yurgeno)",
  "repository": {
    "type": "git",
    "url": "https://github.com/yurgeno/saut.git"
  },
  "bugs": {
    "url": "https://github.com/yurgeno/saut/issues"
  },
  "homepage": "https://github.com/yurgeno/saut#readme",
  "keywords": [
    "ai",
    "ai-agents",
    "agent-skills",
    "skills",
    "llm",
    "claude-code",
    "codex",
    "opencode",
    "lint",
    "tokens",
    "eval",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "saut": "./saut.mjs"
  },
  "files": [
    "saut.mjs",
    "lib/",
    "docs/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsc --noEmit && node --test \"test/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "build:vendor": "esbuild tools/codemirror-entry.mjs --bundle --format=esm --minify --legal-comments=eof --outfile=lib/studio/vendor/codemirror.js"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@types/node": "^24.0.0",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0"
  }
}
